# Copy to the VPS as /etc/kapas/production.env (chmod 600, root-owned).
# Never commit real passwords. Rotate any credential that was shared in chat or email.

RELEASE_VERSION=manual-bootstrap
EDGE_TLS=nginx

# Image tags are overwritten on each deploy in /etc/kapas/image.env
API_IMAGE=ghcr.io/example/kapas-api:replace
WORKER_IMAGE=ghcr.io/example/kapas-worker:replace
PORTAL_IMAGE=ghcr.io/example/kapas-portal:replace
MIGRATE_IMAGE=ghcr.io/example/kapas-migrate:replace

# DNS A records for both hosts must point at your VPS public IP.
PORTAL_HOST=kapaskipukar.com
API_HOST=api.kapaskipukar.com
TLS_ADMIN_EMAIL=ops@kapaskipukar.com

NEXT_PUBLIC_API_URL=https://api.kapaskipukar.com
PUBLIC_API_URL=https://api.kapaskipukar.com
PORTAL_ORIGIN=https://kapaskipukar.com

POSTGRES_DB=kapas_production
POSTGRES_MIGRATOR_USER=kapas_migrator
POSTGRES_MIGRATOR_PASSWORD=generate-a-long-random-password
POSTGRES_APP_USER=kapas_app
POSTGRES_APP_PASSWORD=generate-a-different-long-random-password

MIGRATION_DATABASE_URL=postgresql://kapas_migrator:generate-a-long-random-password@postgres:5432/kapas_production?schema=public
DATABASE_URL=postgresql://kapas_app:generate-a-different-long-random-password@postgres:5432/kapas_production?schema=public

REDIS_PASSWORD=generate-a-long-random-password
REDIS_URL=redis://:generate-a-long-random-password@redis:6379/0

ENCRYPTION_KEY_ID=production-v1
SESSION_SECRET=generate-at-least-32-random-characters
IDENTITY_LOOKUP_PEPPER=generate-a-separate-32-character-pepper
INTERNAL_METRICS_TOKEN=generate-a-long-random-token
PROVIDER_WEBHOOK_SECRET=generate-at-least-32-random-characters
TUSD_HOOK_SECRET=generate-at-least-32-random-characters
EVIDENCE_KEK_SECRET=generate-at-least-32-random-characters

MINIO_ROOT_USER=kapas-minio-prod
MINIO_ROOT_PASSWORD=generate-at-least-32-random-characters
MINIO_IMAGE=ghcr.io/example/kapas-minio:RELEASE.2025-10-15T17-29-55Z

EXPO_PUSH_ENABLED=false
# EXPO_PUSH_ACCESS_TOKEN=

LOG_LEVEL=info
TRUST_PROXY_COUNT=1
QUEUE_PREFIX=kapas-production
WORKER_CONCURRENCY=2
