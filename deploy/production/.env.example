API_HOST=api.example.org
TLS_ADMIN_EMAIL=ops@example.org
NEXT_PUBLIC_API_URL=https://api.example.org
PUBLIC_API_URL=https://api.example.org
PORTAL_ORIGIN=https://portal.example.org
DATABASE_URL=postgresql://kapas_app:replace@postgres:5432/kapas_production?schema=public
MIGRATION_DATABASE_URL=postgresql://kapas_migrator:replace@postgres:5432/kapas_production?schema=public
