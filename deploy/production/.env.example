REDIS_PASSWORD=replace
ENCRYPTION_KEY_ID=replace
SESSION_SECRET=replace-with-at-least-32-random-characters
IDENTITY_LOOKUP_PEPPER=replace-with-separate-at-least-32-random-characters
INTERNAL_METRICS_TOKEN=replace
PROVIDER_WEBHOOK_SECRET=replace
MINIO_ROOT_USER=replace-with-dedicated-minio-user
MINIO_ROOT_PASSWORD=replace-with-at-least-32-random-characters
