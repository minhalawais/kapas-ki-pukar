{
  email {$TLS_ADMIN_EMAIL}
}

{$PORTAL_HOST}:443 {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains" 
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Content-Security-Policy "default-src 'self'; connect-src 'self' https://{$API_HOST}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'none'"
  }
  reverse_proxy portal:3000
}

{$API_HOST} {
  encode zstd gzip
  request_body {
    max_size 30MB
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
  }
  handle /files/* {
    reverse_proxy tusd:8080 {
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
    }
  }
  handle /internal/* {
    abort
  }
  handle {
    reverse_proxy api:4000 {
      transport http {
        read_timeout 120s
        write_timeout 120s
      }
    }
  }
}
