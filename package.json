{
  "name": "kapas-ki-pukaar",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @kapas/api dev",
    "dev:worker": "pnpm --filter @kapas/worker dev",
    "dev:portal": "pnpm --filter @kapas/puwf-portal dev",
    "dev:mobile": "pnpm --filter @kapas/mobile dev",
    "mobile:dev": "pnpm --filter @kapas/mobile dev",
    "mobile:android": "pnpm --filter @kapas/mobile android",
    "mobile:build:dev:apk": "pnpm --filter @kapas/mobile build:dev:apk",
    "dev:preflight": "node tooling/dev/preflight.mjs",
    "mobile:adb-reverse": "powershell -ExecutionPolicy Bypass -File tooling/dev/adb-reverse.ps1",
    "mobile:build:apk": "pnpm --filter @kapas/mobile build:apk",
    "mobile:build:aab": "pnpm --filter @kapas/mobile build:aab",
    "mobile:submit:play": "pnpm --filter @kapas/mobile submit:play",
    "mobile:build:apk:local": "pnpm --filter @kapas/mobile build:apk:local",
    "build": "turbo run build --concurrency=2",
    "lint": "turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "turbo run test --concurrency=1",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:production-evidence": "node tooling/test/production-v3-evidence-upload.mjs",
    "test:e2e": "pnpm --filter @kapas/puwf-portal test:e2e",
    "test:portal": "pnpm --filter @kapas/puwf-portal test",
    "ensure:e2e-staff": "pnpm --filter @kapas/database ensure-e2e-staff",
    "test:portal:e2e": "pnpm ensure:e2e-staff && pnpm --filter @kapas/puwf-portal test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json turbo.json .github/workflows/ci.yml \"apps/api/**/*.{ts,json}\" \"apps/worker/**/*.{ts,json}\" \"packages/{api-contracts,config,database,observability,security}/**/*.{ts,json}\" \"packages/domain/src/{caseLifecycle,repositories,status,workerFacing,index,index.test}.ts\" \"deploy/compose/**/*.{yml,yaml}\" \"docs/backend/phase-{02,03}/**/*.md\"",
    "infra:up": "docker compose --env-file deploy/compose/.env.local -f deploy/compose/compose.local.yml up -d --wait",
    "infra:down": "docker compose --env-file deploy/compose/.env.local -f deploy/compose/compose.local.yml down",
    "infra:logs": "docker compose --env-file deploy/compose/.env.local -f deploy/compose/compose.local.yml logs -f postgres redis",
    "db:generate": "pnpm --filter @kapas/database db:generate",
    "db:migrate": "pnpm --filter @kapas/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @kapas/database db:migrate:deploy",
    "db:reset:test": "pnpm --filter @kapas/database db:reset:test",
    "db:seed:synthetic": "pnpm --filter @kapas/database db:seed:synthetic",
    "openapi:generate": "pnpm --filter @kapas/api openapi:generate",
    "openapi:check": "pnpm --filter @kapas/api openapi:check",
    "brand:generate": "python3 tooling/brand/generate-logo-assets.py",
    "brand:verify": "python3 tooling/brand/verify_logo_assets.py",
    "voice:status": "node tooling/voice-prompts/generate.mjs status",
    "voice:validate": "node tooling/voice-prompts/generate.mjs validate",
    "voice:generate": "node tooling/voice-prompts/generate.mjs generate",
    "voice:generate-rotate": "node tooling/voice-prompts/generate.mjs generate --rotate",
    "voice:approve-validation": "node tooling/voice-prompts/generate.mjs approve-validation",
    "voice:approve-audio": "node tooling/voice-prompts/generate.mjs approve-audio",
    "voice:sync": "node tooling/voice-prompts/generate.mjs sync",
    "voice:remaster": "node tooling/voice-prompts/generate.mjs remaster",
    "voice:verify": "node tooling/voice-prompts/generate.mjs verify",
    "voice:test": "node --test tooling/voice-prompts/generate.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "once": "1.4.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@4": "4.0.1",
      "brace-expansion@5": "5.0.12",
      "@xmldom/xmldom@0.8": "0.8.15",
      "@xmldom/xmldom@0.9": "0.9.12",
      "compression": "1.8.2",
      "js-yaml": "4.3.2",
      "postcss": "8.5.18",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2"
    }
  },
  "version": "1.0.0"
}
