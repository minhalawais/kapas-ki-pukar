# Frontend-only Phase 01 baseline. Never put secrets in NEXT_PUBLIC_ or EXPO_PUBLIC_ variables.

NEXT_PUBLIC_APP_NAME=Kapas ki Pukaar
EXPO_PUBLIC_APP_NAME=Kapas ki Pukaar

# Local demo profile. Production deployments must override these as documented below.
APP_MODE=demo
ENABLE_DEMO_CONTROLS=true
NEXT_PUBLIC_ENABLE_DEMO_CREDENTIALS=true
EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_ENABLE_DEMO_CONTROLS=true

# Backend local-development values. Copy deploy/compose/.env.local.example to
# deploy/compose/.env.local for Docker Compose; do not reuse these in staging/production.
NODE_ENV=development
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=4000
PUBLIC_API_URL=http://127.0.0.1:4000
PORTAL_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://kapas_app:local-app-password@127.0.0.1:5432/kapas_local?schema=public&connection_limit=10
MIGRATION_DATABASE_URL=postgresql://kapas_migrator:local-migration-password@127.0.0.1:5432/kapas_local?schema=public
TEST_DATABASE_URL=postgresql://kapas_migrator:local-migration-password@127.0.0.1:5432/kapas_test?schema=public
REDIS_URL=redis://:local-redis-password@127.0.0.1:6379/0
LOG_LEVEL=info
TRUST_PROXY_COUNT=0
EVIDENCE_ROOT=./storage/evidence
QUARANTINE_ROOT=./storage/quarantine
ENCRYPTION_KEY_ID=local-development-key
SESSION_SECRET=local-only-change-before-any-shared-environment-32-characters
INTERNAL_METRICS_TOKEN=local-metrics-token-change-me
OPENAPI_ENABLED=true
JSON_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
WORKER_CONCURRENCY=2
QUEUE_PREFIX=kapas-local
SHUTDOWN_TIMEOUT_MS=10000

# Production profile:
# APP_MODE=production
# ENABLE_DEMO_CONTROLS=false
# NEXT_PUBLIC_ENABLE_DEMO_CREDENTIALS=false
# EXPO_PUBLIC_APP_MODE=production
# EXPO_PUBLIC_ENABLE_DEMO_CONTROLS=false
# Backend production additionally requires strong unique DATABASE_URL, REDIS_URL,
# SESSION_SECRET and INTERNAL_METRICS_TOKEN values supplied outside the repository.
