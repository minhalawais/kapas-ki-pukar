# Live-backend configuration. Never put secrets in NEXT_PUBLIC_ or EXPO_PUBLIC_ variables.

NEXT_PUBLIC_APP_NAME=Kapas ki Pukaar
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_APP_NAME=Kapas ki Pukaar
NEXT_PUBLIC_BACKEND_ENABLED=true
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_BACKEND_ENABLED=true

# Demo mode is intentionally unsupported. These values must remain disabled.
APP_MODE=production
ENABLE_DEMO_CONTROLS=false
NEXT_PUBLIC_ENABLE_DEMO_CREDENTIALS=false
EXPO_PUBLIC_APP_MODE=production
EXPO_PUBLIC_ENABLE_DEMO_CONTROLS=false
EXPO_PUBLIC_COMPLAINT_PIPELINE_V3_ENABLED=true

# Backend local-development values. Copy deploy/compose/.env.local.example to
# deploy/compose/.env.local for Docker Compose; do not reuse these in staging/production.
NODE_ENV=development
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=4000
PUBLIC_API_URL=http://127.0.0.1:4000
PORTAL_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://kapas_app:local-app-password@127.0.0.1:5432/kapas_local?schema=public&connection_limit=10
MIGRATION_DATABASE_URL=postgresql://kapas_migrator:local-migration-password@127.0.0.1:5432/kapas_local?schema=public
TEST_DATABASE_URL=postgresql://kapas_migrator:local-migration-password@127.0.0.1:5432/kapas_test?schema=public
REDIS_URL=redis://:local-redis-password@127.0.0.1:6379/0
LOG_LEVEL=info
TRUST_PROXY_COUNT=0
EVIDENCE_ROOT=./storage/evidence
QUARANTINE_ROOT=./storage/quarantine
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
ENCRYPTION_KEY_ID=local-development-key
SESSION_SECRET=local-only-change-before-any-shared-environment-32-characters
IDENTITY_LOOKUP_PEPPER=local-identity-lookup-pepper-change-before-shared-environment
INTERNAL_METRICS_TOKEN=local-metrics-token-change-me
PROVIDER_WEBHOOK_SECRET=local-provider-webhook-secret-change-me-32-characters
TUSD_HOOK_SECRET=local-tusd-hook-secret-change-me-32-characters
# Optional. Defaults to ${PUBLIC_API_URL}/files/ (proxied by the API to local tusd).
# Omit this for physical phones so evidence uploads use the same host/port as the API.
# TUSD_PUBLIC_URL=http://10.0.2.2:4000/files/
TUSD_INTERNAL_URL=http://127.0.0.1:1080/files/
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_ACCESS_KEY=kapas-local
OBJECT_STORE_SECRET_KEY=replace-with-the-same-minio-password-as-compose
QUARANTINE_BUCKET=quarantine
PROTECTED_EVIDENCE_BUCKET=protected-evidence
TEMPORARY_BUCKET=temporary
EVIDENCE_KEK_SECRET=local-evidence-kek-change-before-shared-use-32-characters
EXPO_PUSH_ENABLED=false
# EXPO_PUSH_ACCESS_TOKEN=optional-expo-access-token
# Gemini TTS is used only by the offline voice-catalog generation command. Keep
# keys server-side and never expose them through NEXT_PUBLIC_/EXPO_PUBLIC_.
# GEMINI_API_KEY_1=replace-with-secret
# GEMINI_API_KEY_2=replace-with-secret
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
OPENAPI_ENABLED=true
JSON_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
WORKER_CONCURRENCY=2
WORKER_HEALTH_PORT=4100
QUEUE_PREFIX=kapas-local
SHUTDOWN_TIMEOUT_MS=10000

# Backend production additionally requires strong unique DATABASE_URL, REDIS_URL,
# SESSION_SECRET and INTERNAL_METRICS_TOKEN values supplied outside the repository.

# Local portal Playwright E2E (optional; run pnpm ensure:e2e-staff after bootstrap)
# E2E_STAFF_LOGIN=admin@example.local
# E2E_STAFF_PASSWORD=replace-with-local-e2e-password
# E2E_STAFF_TOTP_SECRET=JBSWY3DPEHPK3PXP
