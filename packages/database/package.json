{
  "name": "@kapas/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:reset:test": "tsx scripts/reset-test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts prisma.config.ts --max-warnings 0",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/database.integration.test.ts"
  },
  "dependencies": {
    "@kapas/security": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.8",
    "eslint": "^9.23.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
