generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  key       String   @id @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_metadata")
}

model Complaint {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clientSubmissionId String?   @unique(map: "complaints_client_submission_id_key") @map("client_submission_id") @db.Uuid
  referenceNumber    String    @unique(map: "complaints_reference_number_key") @default(dbgenerated("generate_complaint_reference()")) @map("reference_number") @db.VarChar(32)
  categoryCode       String    @map("category_code") @db.VarChar(3)
  subcategoryCode    String?   @map("subcategory_code") @db.VarChar(7)
  status             String    @default("Received") @db.VarChar(32)
  priority           String    @db.VarChar(16)
  privacyMode        String    @map("privacy_mode") @db.VarChar(4)
  reporterType       String    @map("reporter_type") @db.VarChar(32)
  affectedWorkerType String?   @map("affected_worker_type") @db.VarChar(32)
  gender             String?   @db.VarChar(16)
  submittedAt        DateTime  @map("submitted_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  dueAt              DateTime  @map("due_at") @db.Timestamptz(3)
  legacyDueAt        DateTime? @map("legacy_due_at") @db.Timestamptz(3)
  triageDueAt        DateTime? @map("triage_due_at") @db.Timestamptz(3)
  contactDueAt       DateTime? @map("contact_due_at") @db.Timestamptz(3)
  nextUpdateDueAt    DateTime? @map("next_update_due_at") @db.Timestamptz(3)
  version            Int       @default(1)
  assignedStaffId    String?   @map("assigned_staff_id") @db.Uuid
  createdSource      String    @map("created_source") @db.VarChar(16)
  schemaVersion      Int       @map("schema_version") @db.SmallInt
  retentionState     String    @default("active") @map("retention_state") @db.VarChar(24)
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  workerProfileId    String?   @map("worker_profile_id") @db.Uuid
  evidenceStatus     String    @default("none") @map("evidence_status") @db.VarChar(24)

  incident               Incident?
  location               ComplaintLocation?
  reporter               Reporter?
  privateIdentity        PrivateReporterIdentity?
  privateIdentityFields  PrivateReporterField[]
  workerProfile          WorkerIdentityProfile?      @relation(fields: [workerProfileId], references: [id], onDelete: SetNull)
  evidence               EvidenceAsset[]
  history                CaseHistory[]
  resolutions            Resolution[]
  feedback               WorkerFeedback[]
  informationResponses   WorkerInformationResponse[]
  aiRuns                 AiAnalysisRun[]
  outboxEvents           OutboxEvent[]
  notificationDeliveries NotificationDelivery[]
  legalHolds             LegalHold[]
  retentionDispositions  RetentionDisposition[]
  auditEvents            AuditEvent[]
  workerCredential       WorkerCredential?
  workerSessions         WorkerSession[]
  pushRegistrations      WorkerPushRegistration[]
  evidenceDeclarations   EvidenceDeclaration[]
  intakeReceipt          IntakeReceipt?
  triage                 CaseTriage?
  contacts               WorkerContact[]
  caseFacts              CaseFact[]
  investigationFindings  InvestigationFinding[]
  correctiveActions      CorrectiveAction[]
  externalReferrals      ExternalReferral[]
  caseOutcomes           CaseOutcome[]
  closures               CaseClosure[]
  caseEvidenceLinks      CaseEvidenceLink[]

  @@index([status, priority, submittedAt(sort: Desc)], map: "complaints_queue_idx")
  @@index([updatedAt(sort: Desc)], map: "complaints_updated_at_idx")
  @@index([dueAt], map: "complaints_due_at_idx")
  @@index([triageDueAt], map: "complaints_triage_due_idx")
  @@index([contactDueAt], map: "complaints_contact_due_idx")
  @@index([nextUpdateDueAt], map: "complaints_update_due_idx")
  @@index([categoryCode, subcategoryCode], map: "complaints_category_idx")
  @@index([assignedStaffId, status], map: "complaints_assignment_idx")
  @@index([workerProfileId, submittedAt(sort: Desc)], map: "complaints_worker_profile_submitted_idx")
  @@map("complaints")
}

model EvidenceDeclaration {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId      String    @map("complaint_id") @db.Uuid
  clientMediaId    String    @map("client_media_id") @db.Uuid
  kind             String    @db.VarChar(16)
  displayName      String    @map("display_name") @db.VarChar(255)
  declaredMimeType String    @map("declared_mime_type") @db.VarChar(100)
  totalBytes       BigInt    @map("total_bytes")
  uploadedBytes    BigInt    @default(0) @map("uploaded_bytes")
  status           String    @default("declared") @db.VarChar(24)
  reasonCode       String?   @map("reason_code") @db.VarChar(100)
  quarantineBucket String?   @map("quarantine_bucket") @db.VarChar(100)
  quarantineKey    String?   @map("quarantine_key") @db.Text
  protectedKey     String?   @map("protected_key") @db.Text
  detectedMimeType String?   @map("detected_mime_type") @db.VarChar(100)
  sha256Digest     Bytes?    @map("sha256_digest")
  scanEngine       String?   @map("scan_engine") @db.VarChar(64)
  scanEngineVersion String?  @map("scan_engine_version") @db.VarChar(64)
  scannedAt        DateTime? @map("scanned_at") @db.Timestamptz(3)
  wrappedDataKey   Bytes?    @map("wrapped_data_key")
  encryptionNonce  Bytes?    @map("encryption_nonce")
  encryptionAuthTag Bytes?   @map("encryption_auth_tag")
  encryptionKeyId  String?   @map("encryption_key_id") @db.VarChar(100)
  replacementForId String?   @map("replacement_for_id") @db.Uuid
  capturedAt       DateTime? @map("captured_at") @db.Timestamptz(3)
  recordedAt       DateTime? @map("recorded_at") @db.Timestamptz(3)
  durationMs       Int?      @map("duration_ms")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  complaint Complaint      @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  uploadGrant TusUploadGrant?
  replacementFor EvidenceDeclaration? @relation("EvidenceReplacements", fields: [replacementForId], references: [id], onDelete: Restrict)
  replacements EvidenceDeclaration[] @relation("EvidenceReplacements")
  caseLinks CaseEvidenceLink[]

  @@unique([complaintId, clientMediaId], map: "evidence_declarations_complaint_media_key")
  @@index([complaintId, status], map: "evidence_declarations_complaint_status_idx")
  @@index([replacementForId], map: "evidence_declarations_replacement_for_idx")
  @@map("evidence_declarations")
}

model CaseTriage {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId           String   @unique(map: "case_triage_complaint_key") @map("complaint_id") @db.Uuid
  assignedStaffId       String   @map("assigned_staff_id") @db.Uuid
  categoryCode          String   @map("category_code") @db.VarChar(3)
  subcategoryCode       String?  @map("subcategory_code") @db.VarChar(7)
  priority              String   @db.VarChar(16)
  priorityReason        String   @map("priority_reason") @db.Text
  scope                 String   @db.VarChar(16)
  safetyRisk            Boolean  @map("safety_risk")
  safeguardingRisk      Boolean  @map("safeguarding_risk")
  retaliationRisk       Boolean  @map("retaliation_risk")
  conflictOfInterest    Boolean  @map("conflict_of_interest")
  investigationRoute    String   @map("investigation_route") @db.Text
  nextAction            String   @map("next_action") @db.Text
  nextActionAt          DateTime @map("next_action_at") @db.Timestamptz(3)
  completedBy           String   @map("completed_by") @db.Uuid
  completedAt           DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  complaint             Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)

  @@index([assignedStaffId, completedAt(sort: Desc)], map: "case_triage_assignee_idx")
  @@map("case_triage")
}

model WorkerContact {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId           String    @map("complaint_id") @db.Uuid
  channel               String    @db.VarChar(24)
  outcome               String    @db.VarChar(32)
  occurredAt            DateTime  @map("occurred_at") @db.Timestamptz(3)
  staffActorId          String    @map("staff_actor_id") @db.Uuid
  language              String    @db.VarChar(8)
  safeContactConfirmed  Boolean   @map("safe_contact_confirmed")
  emergencyOverride     Boolean   @default(false) @map("emergency_override")
  overrideReason        String?   @map("override_reason") @db.Text
  representativeName    String?   @map("representative_name") @db.VarChar(160)
  additionalFacts       String?   @map("additional_facts") @db.Text
  requestedOutcome      String?   @map("requested_outcome") @db.Text
  readBackConfirmed     Boolean?  @map("read_back_confirmed")
  followUpAt            DateTime? @map("follow_up_at") @db.Timestamptz(3)
  summary               String    @db.Text
  visibility            String    @db.VarChar(24)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  complaint             Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  facts                 CaseFact[]
  evidenceLinks         CaseEvidenceLink[]

  @@index([complaintId, occurredAt(sort: Desc)], map: "worker_contacts_complaint_at_idx")
  @@index([outcome, followUpAt], map: "worker_contacts_outcome_followup_idx")
  @@map("worker_contacts")
}

model CaseFact {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId           String    @map("complaint_id") @db.Uuid
  workerContactId       String?   @map("worker_contact_id") @db.Uuid
  fact                  String    @db.Text
  structuredValue       Json?     @map("structured_value")
  sourceType            String    @map("source_type") @db.VarChar(32)
  sourceRecordId        String?   @map("source_record_id") @db.Uuid
  verificationState     String    @map("verification_state") @db.VarChar(24)
  recordedBy            String    @map("recorded_by") @db.Uuid
  recordedAt            DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(3)
  complaint             Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  workerContact         WorkerContact? @relation(fields: [workerContactId], references: [id], onDelete: Restrict)

  @@index([complaintId, recordedAt(sort: Desc)], map: "case_facts_complaint_at_idx")
  @@map("case_facts")
}

model InvestigationFinding {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId           String   @map("complaint_id") @db.Uuid
  issue                 String   @db.Text
  allegation            String   @db.Text
  conclusion            String   @db.VarChar(32)
  rationale             String   @db.Text
  rootCause             String?  @map("root_cause") @db.Text
  affectedScope         String?  @map("affected_scope") @db.Text
  recommendedAction     String?  @map("recommended_action") @db.Text
  recordedBy            String   @map("recorded_by") @db.Uuid
  recordedAt            DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  complaint             Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  evidenceLinks         CaseEvidenceLink[]

  @@index([complaintId, recordedAt(sort: Desc)], map: "investigation_findings_complaint_at_idx")
  @@map("investigation_findings")
}

model CorrectiveAction {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId           String    @map("complaint_id") @db.Uuid
  type                  String    @db.VarChar(64)
  title                 String    @db.VarChar(200)
  description           String    @db.Text
  ownerStaffId          String    @map("owner_staff_id") @db.Uuid
  responsibleParty      String?   @map("responsible_party") @db.VarChar(200)
  expectedOutcome       String    @map("expected_outcome") @db.Text
  workerVisibleSummary  String?   @map("worker_visible_summary") @db.Text
  state                 String    @default("planned") @db.VarChar(24)
  agreedAt              DateTime? @map("agreed_at") @db.Timestamptz(3)
  dueAt                 DateTime  @map("due_at") @db.Timestamptz(3)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(3)
  followUpAt            DateTime? @map("follow_up_at") @db.Timestamptz(3)
  actualResult          String?   @map("actual_result") @db.Text
  cancellationReason    String?   @map("cancellation_reason") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  complaint             Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  evidenceLinks         CaseEvidenceLink[]

  @@index([complaintId, state, dueAt], map: "corrective_actions_case_state_due_idx")
  @@index([ownerStaffId, state, dueAt], map: "corrective_actions_owner_state_due_idx")
  @@map("corrective_actions")
}

model ExternalReferral {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId           String    @map("complaint_id") @db.Uuid
  organization          String    @db.VarChar(200)
  reason                String    @db.Text
  referenceNumber       String?   @map("reference_number") @db.VarChar(100)
  consentState          String    @map("consent_state") @db.VarChar(24)
  referredAt            DateTime  @map("referred_at") @db.Timestamptz(3)
  ownerStaffId          String    @map("owner_staff_id") @db.Uuid
  status                String    @db.VarChar(24)
  outcome               String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  complaint             Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  evidenceLinks         CaseEvidenceLink[]

  @@index([complaintId, referredAt(sort: Desc)], map: "external_referrals_complaint_at_idx")
  @@map("external_referrals")
}

model CaseOutcome {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId           String    @map("complaint_id") @db.Uuid
  remedyType            String    @map("remedy_type") @db.VarChar(64)
  details               String    @db.Text
  remedyDelivered       Boolean   @map("remedy_delivered")
  deliveredAt           DateTime? @map("delivered_at") @db.Timestamptz(3)
  amountPaid            Decimal?  @map("amount_paid") @db.Decimal(14, 2)
  communicated          Boolean
  communicationChannel  String?   @map("communication_channel") @db.VarChar(24)
  communicatedAt        DateTime? @map("communicated_at") @db.Timestamptz(3)
  communicationExceptionReason String? @map("communication_exception_reason") @db.Text
  retaliationSafetyResult String? @map("retaliation_safety_result") @db.Text
  workerVisibleSummary  String    @map("worker_visible_summary") @db.Text
  recordedBy            String    @map("recorded_by") @db.Uuid
  recordedAt            DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(3)
  complaint             Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  evidenceLinks         CaseEvidenceLink[]

  @@index([complaintId, recordedAt(sort: Desc)], map: "case_outcomes_complaint_at_idx")
  @@map("case_outcomes")
}

model CaseClosure {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId           String   @map("complaint_id") @db.Uuid
  code                  String   @db.VarChar(32)
  summary               String   @db.Text
  closedBy              String   @map("closed_by") @db.Uuid
  closedAt              DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  checklistSnapshot     Json     @map("checklist_snapshot")
  communicationExceptionReason String? @map("communication_exception_reason") @db.Text
  outstandingReferralAcknowledged Boolean @map("outstanding_referral_acknowledged")
  complaint             Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  evidenceLinks         CaseEvidenceLink[]

  @@index([complaintId, closedAt(sort: Desc)], map: "case_closures_complaint_closed_idx")
  @@map("case_closures")
}

model CaseEvidenceLink {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId           String   @map("complaint_id") @db.Uuid
  evidenceId            String   @map("evidence_id") @db.Uuid
  workerContactId       String?  @map("worker_contact_id") @db.Uuid
  findingId             String?  @map("finding_id") @db.Uuid
  correctiveActionId    String?  @map("corrective_action_id") @db.Uuid
  externalReferralId    String?  @map("external_referral_id") @db.Uuid
  caseOutcomeId         String?  @map("case_outcome_id") @db.Uuid
  caseClosureId         String?  @map("case_closure_id") @db.Uuid
  visibility            String   @db.VarChar(24)
  sensitivity           String   @db.VarChar(24)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  complaint             Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  evidence              EvidenceDeclaration @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  workerContact         WorkerContact? @relation(fields: [workerContactId], references: [id], onDelete: Restrict)
  finding               InvestigationFinding? @relation(fields: [findingId], references: [id], onDelete: Restrict)
  correctiveAction      CorrectiveAction? @relation(fields: [correctiveActionId], references: [id], onDelete: Restrict)
  externalReferral      ExternalReferral? @relation(fields: [externalReferralId], references: [id], onDelete: Restrict)
  caseOutcome           CaseOutcome? @relation(fields: [caseOutcomeId], references: [id], onDelete: Restrict)
  caseClosure           CaseClosure? @relation(fields: [caseClosureId], references: [id], onDelete: Restrict)

  @@unique([evidenceId], map: "case_evidence_links_evidence_key")
  @@index([complaintId, createdAt], map: "case_evidence_links_complaint_at_idx")
  @@map("case_evidence_links")
}

model TusUploadGrant {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  evidenceId     String    @unique(map: "tus_upload_grants_evidence_id_key") @map("evidence_id") @db.Uuid
  tusUploadId    String?   @unique(map: "tus_upload_grants_upload_id_key") @map("tus_upload_id") @db.VarChar(200)
  tokenHash      String    @unique(map: "tus_upload_grants_token_hash_key") @map("token_hash") @db.VarChar(128)
  status         String    @default("active") @db.VarChar(24)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  terminatedAt   DateTime? @map("terminated_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  evidence EvidenceDeclaration @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([expiresAt, status], map: "tus_upload_grants_expiry_status_idx")
  @@map("tus_upload_grants")
}

model IntakeReceipt {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId        String   @unique(map: "intake_receipts_complaint_id_key") @map("complaint_id") @db.Uuid
  clientSubmissionId String   @unique(map: "intake_receipts_client_submission_id_key") @map("client_submission_id") @db.Uuid
  idempotencyKeyHash String   @map("idempotency_key_hash") @db.VarChar(128)
  requestHash        String   @map("request_hash") @db.VarChar(128)
  secretCiphertext   Bytes    @map("secret_ciphertext")
  secretNonce        Bytes    @map("secret_nonce")
  secretAuthTag      Bytes    @map("secret_auth_tag")
  secretKeyId        String   @map("secret_key_id") @db.VarChar(100)
  cryptoVersion      Int      @default(1) @map("crypto_version") @db.SmallInt
  acceptedAt         DateTime @map("accepted_at") @db.Timestamptz(3)
  recoveryExpiresAt  DateTime @map("recovery_expires_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)

  @@index([recoveryExpiresAt], map: "intake_receipts_recovery_expiry_idx")
  @@map("intake_receipts")
}

model Incident {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId       String    @unique(map: "incidents_complaint_id_key") @map("complaint_id") @db.Uuid
  whenLabel         String    @map("when_label") @db.VarChar(100)
  occurredAt        DateTime? @map("occurred_at") @db.Timestamptz(3)
  description       String?   @db.Text
  currentDanger     Boolean   @default(false) @map("current_danger")
  immediateDanger   Boolean   @default(false) @map("immediate_danger")
  othersAffected    String    @map("others_affected") @db.VarChar(24)
  structuredAnswers Json      @default("{}") @map("structured_answers")
  schemaVersion     Int       @map("schema_version") @db.SmallInt
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("incidents")
}

model ComplaintLocation {
  id                         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId                String   @unique(map: "complaint_locations_complaint_id_key") @map("complaint_id") @db.Uuid
  province                   String   @db.VarChar(100)
  district                   String   @db.VarChar(100)
  tehsil                     String?  @db.VarChar(100)
  villageLabel               String?  @map("village_label") @db.VarChar(160)
  descriptivePlace           String?  @map("descriptive_place") @db.VarChar(500)
  source                     String   @db.VarChar(16)
  accuracyMeters             Int?     @map("accuracy_meters")
  exactCoordinatesCiphertext Bytes?   @map("exact_coordinates_ciphertext")
  exactCoordinatesNonce      Bytes?   @map("exact_coordinates_nonce")
  exactCoordinatesKeyId      String?  @map("exact_coordinates_key_id") @db.VarChar(100)
  exactCoordinatesAlgorithm  String?  @map("exact_coordinates_algorithm") @db.VarChar(32)
  exactCoordinatesAuthTag    Bytes?   @map("exact_coordinates_auth_tag")
  exactCoordinatesAadContext String?  @map("exact_coordinates_aad_context") @db.VarChar(160)
  cryptoVersion              Int?     @map("crypto_version") @db.SmallInt
  analyticsProvince          String   @map("analytics_province") @db.VarChar(100)
  analyticsDistrict          String   @map("analytics_district") @db.VarChar(100)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([analyticsProvince, analyticsDistrict], map: "complaint_locations_analytics_geo_idx")
  @@map("complaint_locations")
}

model Reporter {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId    String   @unique(map: "reporters_complaint_id_key") @map("complaint_id") @db.Uuid
  type           String   @db.VarChar(32)
  displayName    String?  @map("display_name") @db.VarChar(160)
  contactAllowed Boolean  @default(false) @map("contact_allowed")
  contactPreference String @default("do-not-initiate") @map("contact_preference") @db.VarChar(24)
  safeContactWindow String? @map("safe_contact_window") @db.VarChar(160)
  preferredLanguage String? @map("preferred_language") @db.VarChar(8)
  safeVoicemail    Boolean @default(false) @map("safe_voicemail")
  representativeContact String? @map("representative_contact") @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("reporters")
}

model PrivateReporterIdentity {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId   String   @unique(map: "private_reporter_identities_complaint_id_key") @map("complaint_id") @db.Uuid
  kind          String   @db.VarChar(16)
