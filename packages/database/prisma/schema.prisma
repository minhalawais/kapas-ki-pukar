  tokenHash         String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.VarChar(128)
  assurance         String    @default("password") @db.VarChar(24)
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(100)
  deviceClass       String?   @map("device_class") @db.VarChar(50)
  lastIpHash        String?   @map("last_ip_hash") @db.VarChar(128)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "sessions_user_revoked_idx")
  @@index([idleExpiresAt], map: "sessions_idle_expiry_idx")
  @@map("sessions")
}

model LoginAttempt {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  loginHash  String   @map("login_hash") @db.VarChar(128)
  outcome    String   @db.VarChar(24)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  ipHash     String?  @map("ip_hash") @db.VarChar(128)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([loginHash, occurredAt], map: "login_attempts_login_at_idx")
  @@index([userId, occurredAt], map: "login_attempts_user_at_idx")
  @@map("login_attempts")
}

model WorkerCredential {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId String    @unique(map: "worker_credentials_complaint_id_key") @map("complaint_id") @db.Uuid
  secretHash  String    @map("secret_hash") @db.VarChar(255)
  issuedAt    DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  rotatedAt   DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)

  @@map("worker_credentials")
}

model WorkerSession {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId String    @map("complaint_id") @db.Uuid
  tokenHash   String    @unique(map: "worker_sessions_token_hash_key") @map("token_hash") @db.VarChar(128)
  issuedAt    DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, revokedAt], map: "worker_sessions_complaint_revoked_idx")
  @@map("worker_sessions")
}

model WorkerPushRegistration {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  complaintId      String    @map("complaint_id") @db.Uuid
  expoPushToken    String    @map("expo_push_token") @db.VarChar(255)
  tokenFingerprint String    @unique(map: "worker_push_registrations_token_fp_key") @map("token_fingerprint") @db.VarChar(64)
  platform         String    @db.VarChar(16)
  locale           String    @default("en") @db.VarChar(12)
  deviceInstallId  String?   @map("device_install_id") @db.VarChar(64)
  registeredAt     DateTime  @default(now()) @map("registered_at") @db.Timestamptz(3)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  complaint        Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, revokedAt], map: "worker_push_registrations_complaint_idx")
  @@map("worker_push_registrations")
}

model WorkerIdentityProfile {
  id              String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneBlindIndex String                 @unique(map: "worker_identity_profiles_phone_blind_key") @map("phone_blind_index") @db.VarChar(128)
  cnicBlindIndex  String?                @map("cnic_blind_index") @db.VarChar(128)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  complaints      Complaint[]
  sessions        WorkerHistorySession[]

  @@index([cnicBlindIndex], map: "worker_identity_profiles_cnic_blind_idx")
  @@map("worker_identity_profiles")
}

model WorkerHistorySession {
  id        String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  profileId String                @map("profile_id") @db.Uuid
  tokenHash String                @unique(map: "worker_history_sessions_token_hash_key") @map("token_hash") @db.VarChar(128)
  issuedAt  DateTime              @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime?             @map("revoked_at") @db.Timestamptz(3)
  profile   WorkerIdentityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, revokedAt], map: "worker_history_sessions_profile_revoked_idx")
  @@map("worker_history_sessions")
}
