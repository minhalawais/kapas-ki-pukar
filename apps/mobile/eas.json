{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "development",
        "EXPO_PUBLIC_ENABLE_DEMO_CONTROLS": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_USE_FAST_RESOLVER": "1",
        "EXPO_PUBLIC_APP_MODE": "demo",
        "EXPO_PUBLIC_ENABLE_DEMO_CONTROLS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_APP_MODE": "production",
        "EXPO_PUBLIC_ENABLE_DEMO_CONTROLS": "false"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
