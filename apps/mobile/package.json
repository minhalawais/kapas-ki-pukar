{
  "name": "@kapas/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:metro": "expo start --dev-client",
    "android": "expo run:android",
    "build:dev:apk": "npx --yes eas-cli@27.1.0 build --platform android --profile development --non-interactive",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "npx --yes eas-cli@27.1.0 build --platform android --profile preview --non-interactive",
    "build:aab": "npx --yes eas-cli@27.1.0 build --platform android --profile production --non-interactive",
    "build:aab:wait": "npx --yes eas-cli@27.1.0 build --platform android --profile production --non-interactive --wait",
    "submit:play": "npx --yes eas-cli@27.1.0 submit --platform android --profile production --non-interactive --latest",
    "build:apk:local": "npx --yes eas-cli@27.1.0 build --platform android --profile preview --local",
    "eas-build-pre-install": "corepack enable && corepack prepare pnpm@9.15.0 --activate && cd ../.. && pnpm install --frozen-lockfile",
    "eas-build-post-install": "cd ../.. && pnpm db:generate",
    "build": "node ../../tooling/voice-prompts/generate.mjs verify && expo export",
    "lint": "eslint app src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/gulzar": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo-google-fonts/noto-nastaliq-urdu": "^0.4.2",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@kapas/ai": "workspace:*",
    "@kapas/design-tokens": "workspace:*",
    "@kapas/domain": "workspace:*",
    "@kapas/localization": "workspace:*",
    "@kapas/mock-services": "workspace:*",
    "@kapas/speech": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.69.0",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-background-task": "~57.0.21",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-location": "~57.0.22",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1",
    "tus-js-client": "^4.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@types/react": "~19.2.18",
    "eslint": "^9.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
