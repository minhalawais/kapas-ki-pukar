# Expo reads environment files from this directory (the Expo project root).
# For a physical phone, replace this address with the development computer's
# current Wi-Fi IPv4 address. Evidence uploads use ${EXPO_PUBLIC_API_URL}/files/.
# For USB + adb reverse only, use 127.0.0.1 and set EXPO_PUBLIC_TUSD_URL too.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# EXPO_PUBLIC_TUSD_URL=http://127.0.0.1:4000/files/
EXPO_PUBLIC_BACKEND_ENABLED=true
EXPO_PUBLIC_APP_MODE=production
EXPO_PUBLIC_ENABLE_DEMO_CONTROLS=false
EXPO_PUBLIC_UPLOAD_PROTOCOL_V2_ENABLED=true
EXPO_PUBLIC_COMPLAINT_PIPELINE_V3_ENABLED=true
