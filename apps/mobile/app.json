{
  "expo": {
    "name": "Kapas ki Pukaar",
    "slug": "kapas-ki-pukaar",
    "scheme": "kapas",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.puwf.kapas",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kapas ki Pukaar uses your location only when you choose it to identify where the reported incident happened."
      }
    },
    "android": {
      "package": "org.puwf.kapas",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#F7F3E8"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Kapas ki Pukaar to record your voice when you choose to add a voice statement."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kapas ki Pukaar to use your location only when you choose it for a complaint."
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "./plugins/with-disabled-native-rtl",
      "expo-font",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F3E8"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F7F3E8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68fabe6e-1b8a-4035-ab6b-255b11ab411f"
      }
    },
    "owner": "minhalawais1"
  }
}
