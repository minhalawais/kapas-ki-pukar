{
  "name": "@kapas/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "node ../../tooling/test/require-integration-env.mjs TEST_DATABASE_URL REDIS_URL && vitest run src/worker.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@kapas/ai": "workspace:*",
    "@kapas/config": "workspace:*",
    "@kapas/database": "workspace:*",
    "@kapas/domain": "workspace:*",
    "@kapas/observability": "workspace:*",
    "@kapas/security": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "bullmq": "^6.3.15",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^9.23.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
