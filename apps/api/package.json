{
  "name": "@kapas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "openapi:generate": "tsx scripts/generate-openapi.ts write",
    "openapi:check": "tsx scripts/generate-openapi.ts check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "node ../../tooling/test/require-integration-env.mjs TEST_DATABASE_URL REDIS_URL && vitest run src/app.integration.test.ts src/auth.integration.test.ts src/intake.integration.test.ts src/v3-evidence-upload.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/http-proxy": "11.0.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.2",
    "@kapas/api-contracts": "workspace:*",
    "@kapas/config": "workspace:*",
    "@kapas/database": "workspace:*",
    "@kapas/domain": "workspace:^",
    "@kapas/observability": "workspace:*",
    "@kapas/security": "workspace:^",
    "@kapas/validation": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "once": "1.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/node": "^26.6.5",
    "eslint": "^9.23.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
